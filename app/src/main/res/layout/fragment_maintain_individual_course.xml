<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MaintainIndividualCourseFragment"
    tools:ignore="ExtraText">

    <ImageView
        android:id="@+id/mainlogo"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:alpha="@string/alpha_sub_screen"
        android:contentDescription="@string/logo"
        android:src="@drawable/mainlogoscr"/>
    <RelativeLayout
        android:id="@+id/title_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"

        android:layout_marginTop="16dp"

        android:orientation="vertical">

    <TextView
        android:id="@+id/textView_course_maintenance_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:text="@string/maintain_individual_course"
        android:textAlignment="center"
        android:textSize="24sp"
        android:textStyle="bold" />
    </RelativeLayout>
    <LinearLayout
        android:id="@+id/layout_course_description_header"
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@id/title_group"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:textAlignment="center"
        android:textSize="24sp"
        android:textStyle="bold">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textViewCourseDescriptionlabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="none"
            android:hint="@string/course_description">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/textViewCourseDescription"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/course_description" />
        </com.google.android.material.textfield.TextInputLayout>



    </LinearLayout>


    <LinearLayout
        android:id="@+id/layout_center_content"
        android:layout_width="match_parent"
        android:layout_height="0dp" 
        app:layout_constraintTop_toBottomOf="@id/layout_course_description_header"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_controlbar"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="8dp"
        android:paddingBottom="15dp">

        <!-- First Column: Course Marks -->
        <LinearLayout
            android:id="@+id/layout_course_marks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/course_marks"
                 />

            <!-- RecyclerView or ListView for course marks will go here-->
           <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewCourseMarks"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <!-- Second Column: All Marks -->
        <LinearLayout
            android:id="@+id/layout_all_marks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/all_marks"
                 />

            <!-- RecyclerView or ListView for all marks will go here -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewAllMarks"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_bottom_controlbar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:id="@+id/layout_bottom_action_buttons"
            android:orientation="horizontal">


            <Button
                android:id="@+id/buttonDeleteCourse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/delete_this_course" />

            <Button
                android:id="@+id/buttonUpdateCompleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="8dp"
                android:text="@string/update_completed" />

        </LinearLayout>
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:id="@+id/layout_bottom_buttons">

            <ImageButton
                android:id="@+id/left_btn"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/left_nav"
                android:src="@drawable/leftarrowclick"
                tools:ignore="TouchTargetSizeCheck,DuplicateClickableBoundsCheck" />

            <ImageButton
                android:id="@+id/home_btn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="3"
                android:src="@drawable/home_button"
                android:background="@android:color/transparent"
                android:contentDescription="@string/home"
                android:gravity="center_horizontal"
                android:text="@string/home" />

            <ImageButton
                android:id="@+id/right_btn"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/right_nav"
                android:src="@drawable/rightarrowclick"
                tools:ignore="ImageContrastCheck,TouchTargetSizeCheck" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>