<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_alignParentBottom="true"
    tools:context=".MaintBoatFragment">


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="@string/alpha_sub_screen"
        android:contentDescription="@string/logo"
        android:scaleType="centerInside"
        android:src="@drawable/mainlogoscr" />

    <!-- TODO: Update blank fragment layout -->


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textView_boat_maintenance_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal">

        </TextView>


        <RelativeLayout
            android:id="@+id/title_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"

            android:layout_marginTop="16dp"

            android:orientation="vertical">

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:text="@string/boat_maintenance"
                android:textAlignment="center"
                android:textSize="24sp"
                android:textStyle="bold" />
        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/layout_bottom_controlbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/title_group"


            android:layout_gravity="bottom">

            <LinearLayout
                android:id="@+id/layout_bottom_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal">


                <ImageButton
                    android:id="@+id/left_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/left_nav"
                    android:src="@drawable/leftarrowclick"
                    tools:ignore="TouchTargetSizeCheck" />

                <ImageButton
                    android:id="@+id/home_btn"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="3"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/home"
                    android:gravity="center_horizontal"
                    android:src="@drawable/home_button"
                    android:text="@string/home" />

                <ImageButton
                    android:id="@+id/right_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/right_nav"
                    android:src="@drawable/rightarrowclick"
                    tools:ignore="ImageContrastCheck,TouchTargetSizeCheck" />


            </LinearLayout>

            <LinearLayout
                android:id="@id/layout_bottom_action_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@id/layout_bottom_buttons">


                <Button
                    android:id="@+id/button_add_new"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/add_new"
                    tools:ignore="ExtraText,Suspicious0dp,TextContrastCheck,VisualLintButtonSize">

                </Button>

                <Button
                    android:id="@+id/button_backup_all"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/backup_all" />

                <Button
                    android:id="@+id/button_restore_all"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/restore_all" />

            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/title_group">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView_boats"
                android:layout_width="match_parent"

                android:layout_height="620dp"



                tools:ignore="SpeakableTextPresentCheck" />
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
