<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_alignParentBottom="true"
    tools:context=".MaintCourseFragment">


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="@string/alpha_sub_screen"
        android:contentDescription="@string/logo"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/mainlogo" />

    <!-- TODO: Update blank fragment layout -->


    <RelativeLayout
        android:id="@+id/title_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"

        android:orientation="vertical">

        <TextView
            android:id="@+id/textView_course_maintenance_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:text="@string/course_maintenance"
            android:textAlignment="center"
            android:textSize="24sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layout_bottom_controlbar"
        android:orientation="vertical"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_alignParentBottom="true">
        <LinearLayout
            android:id="@+id/layout_bottom_action_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:boxBackgroundMode="none">

                <EditText
                    android:id="@+id/new_course_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:hint="@string/new_course_description"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:textAlignment="textStart"
                    android:textStyle="bold"
                    tools:ignore="LabelFor" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/button_add_new"


                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_new_course"
                android:layout_gravity="end"
                tools:ignore="ExtraText,TextContrastCheck,VisualLintButtonSize">


            </Button>


        </LinearLayout>
        <LinearLayout
            android:id="@+id/layout_bottom_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <ImageButton
                android:id="@+id/left_btn"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/left_nav"
                android:src="@drawable/leftarrowclick"
                tools:ignore="TouchTargetSizeCheck" />

            <ImageButton
                android:id="@+id/home_btn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="3"
                android:background="@android:color/transparent"
                android:contentDescription="@string/home"
                android:gravity="center_horizontal"
                android:src="@drawable/home_button"
                android:text="@string/home" />

            <ImageButton
                android:id="@+id/right_btn"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/right_nav"
                android:src="@drawable/rightarrowclick"
                tools:ignore="ImageContrastCheck,TouchTargetSizeCheck" />


        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_middle_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_above="@id/layout_bottom_controlbar"
        android:layout_below="@id/title_group">



            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/existing_courses"
                android:textAlignment="textStart"
                android:textStyle="bold"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewCourse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:ignore="SpeakableTextPresentCheck" />




    </LinearLayout>

</RelativeLayout>