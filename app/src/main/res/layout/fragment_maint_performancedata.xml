<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_alignParentBottom="true"
    tools:context=".MaintainPerformanceDataFragment">


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="@string/alpha_sub_screen"
        android:contentDescription="@string/logo"
        android:scaleType="centerInside"
        android:src="@drawable/mainlogoscr" />

    <!-- TODO: Update blank fragment layout -->


    <RelativeLayout
        android:id="@+id/title_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"

        android:orientation="vertical">

        <TextView
            android:id="@+id/textView_boat_maintenance_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"


            android:text="@string/maintain_boat_performance"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView_boat_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textView_boat_maintenance_title"
            android:layout_centerHorizontal="true"
            android:text="@string/boat_name"

            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/textView_boat_name"

            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView_wind_strength"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/textView_boat_maintenance_title"
                android:layout_centerHorizontal="true"
                android:text="@string/true_wind"

                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView_tack_angle"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
               
                android:layout_below="@id/textView_boat_maintenance_title"
                android:layout_centerHorizontal="true"
                android:text="@string/tack_angle"

                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layout_bottom_controlbar"
        android:layout_width="match_parent"

        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"

        android:orientation="vertical">

        <LinearLayout
            android:id="@id/layout_bottom_action_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <Button
                android:id="@+id/button_add_new"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_new"
                tools:ignore="ExtraText,Suspicious0dp,TextContrastCheck,VisualLintButtonSize">

            </Button>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_bottom_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal">


            <ImageButton
                android:id="@+id/left_btn"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/left_nav"
                android:src="@drawable/leftarrowclick"
                tools:ignore="TouchTargetSizeCheck" />

            <ImageButton
                android:id="@+id/home_btn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="3"
                android:background="@android:color/transparent"
                android:contentDescription="@string/home"
                android:gravity="center_horizontal"
                android:src="@drawable/home_button"
                android:text="@string/home" />

            <ImageButton
                android:id="@+id/right_btn"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/right_nav"
                android:src="@drawable/rightarrowclick"
                tools:ignore="ImageContrastCheck,TouchTargetSizeCheck" />


        </LinearLayout>


    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"

        android:layout_above="@id/layout_bottom_controlbar"
        android:layout_below="@id/title_group">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView_performance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"


            tools:ignore="SpeakableTextPresentCheck" />
    </RelativeLayout>

</RelativeLayout>


